{
  "manifest_version": 3,
  "name": "BR Nearest Station Seat Finder",
  "version": "1.0.0",
  "description": "Instantly check nearby stations for available Bangladesh Railway train seats when direct tickets are sold out.",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://eticket.railway.gov.bd/*",
    "https://railspaapi.shohoz.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find seats at nearby stations",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://eticket.railway.gov.bd/*"],
      "js": [
        "data/stations.js",
        "data/site-names.js",
        "data/trains.js",
        "lib/geo.js",
        "lib/stations.js",
        "lib/planner.js",
        "lib/finder.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
